rules_version = '2';

// firestore.rules
//
// OJO: ESTE ARCHIVO NO SE APLICA SOLO. Las reglas que rigen viven en la consola
// de Firebase (Firestore Database -> Reglas). Este archivo es la versión
// versionada y revisable; para que rija hay que pegarlo en la consola y
// publicar, o usar la CLI:
//     firebase deploy --only firestore:rules
//
// LO QUE RIGÍA HASTA EL 13/9/2026 (verificado por prueba): lectura pública de
// TODO y escritura para cualquier usuario autenticado de Firebase. Alcanzaba
// para que el sitio funcionara, pero era más laxo de lo que hace falta:
// cualquier colección nueva nacía pública, y si el registro estuviera abierto,
// cualquier cuenta podría reescribir las escalas salariales de un sitio
// público. Estas reglas cierran las dos cosas:
//
//   - se lee sin registro sólo lo que el sitio necesita: los convenios y sus
//     escalas, las tablas de Ganancias, las de contribuciones, las novedades y
//     los acuerdos. Todo lo demás está cerrado hasta que se abra a propósito acá;
//   - escribe únicamente el administrador, identificado por el UID de su
//     usuario de Firebase Authentication (desde el 11/10/2026; antes era por el
//     mail, y cambiar el mail obligaba a republicar las reglas).
//
// El UID no cambia aunque se cambie el mail o la contraseña del usuario. Está
// en la consola, en Authentication -> Users. SI ALGÚN DÍA SE CREA OTRO USUARIO
// ADMINISTRADOR, hay que poner su UID acá y publicar ANTES de usar el panel con
// él: si no, el panel deja de poder guardar. La consola de Firebase sigue
// accesible igual (las reglas no la gobiernan), así que nunca es un encierro
// definitivo.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- El único que escribe ------------------------------------------
    // La cuenta de Firebase Authentication (proveedor "password") con la que
    // se entra a /admin, hoy admin@liquidar.ar, identificada por su UID.
    function esAdmin() {
      return request.auth != null
          && request.auth.uid == "yx2H1OsUirUTvevmtTasVnSU5Zw1";
    }

    // --- El vigía (scripts/vigia.mjs) ----------------------------------
    // La cuenta vigia@liquidar.ar con la que corre el robot de novedades. Sólo
    // puede escribir en sus propias colecciones (abajo): las públicas siguen
    // siendo del administrador, así que aunque el código se equivoque no puede
    // tocar una escala ni una tabla. Reemplazar UID_DEL_VIGIA por el UID real
    // (Authentication -> Users) antes de pegar.
    function esVigia() {
      return request.auth != null
          && request.auth.uid == "UID_DEL_VIGIA";
    }

    // --- Convenios y sus escalas ---------------------------------------
    // Lectura pública: es lo que hace funcionar la calculadora sin registro.
    match /convenios/{convenioId} {
      allow read: if true;
      allow write: if esAdmin();

      match /escalas/{periodo} {
        allow read: if true;
        allow write: if esAdmin();
      }
    }

    // --- Parámetros del impuesto a las Ganancias, por período -----------
    match /parametros_ganancias/{periodo} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Parámetros de contribuciones patronales, por período -----------
    // Lo que el recibo necesita para la sección "Costo total empleador"
    // (art. 140 inc. j) LCT, Decreto 407/2026).
    match /parametros_contribuciones/{periodo} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Novedades del sitio y de cada convenio ------------------------
    match /novedades/{novedadId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Acuerdos paritarios y escalas de cada convenio ----------------
    // El documento guarda los datos y la URL de descarga; el archivo en sí
    // vive en Storage (ver storage.rules).
    match /acuerdos/{acuerdoId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Borradores del vigía ------------------------------------------
    // Lo que el vigía deja preparado y el administrador publica o descarta
    // desde la Bandeja de /admin. Nadie más los lee. El vigía crea, y sólo
    // puede actualizar un borrador mientras sigue abierto (pendiente o
    // requiere_revision): nunca reabre uno descartado ni toca uno publicado.
    // Borra sólo el administrador.
    match /borradores/{borradorId} {
      allow read: if esAdmin() || esVigia();
      allow create: if esAdmin() || esVigia();
      allow update: if esAdmin()
          || (esVigia() && resource.data.estado in ["pendiente", "requiere_revision"]);
      allow delete: if esAdmin();
    }

    // --- Memoria del vigía ---------------------------------------------
    // vigia/estado (qué vio de cada fuente), vigia_corridas (una por corrida),
    // vigia_tramos (los tramos de un acuerdo que cargó el dueño) y
    // vigia_acuerdos_leidos (lo que el vigía leyó de cada documento).
    match /vigia/{documento} {
      allow read, write: if esAdmin() || esVigia();
    }
    match /vigia_corridas/{corridaId} {
      allow read, write: if esAdmin() || esVigia();
    }
    match /vigia_tramos/{convenioId} {
      allow read, write: if esAdmin() || esVigia();
    }
    match /vigia_acuerdos_leidos/{acuerdoId} {
      allow read, write: if esAdmin() || esVigia();
    }

    // --- Todo lo demás está cerrado ------------------------------------
    // Cualquier colección que se agregue en el futuro arranca denegada, y hay
    // que habilitarla a propósito acá (y volver a pegar en la consola).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

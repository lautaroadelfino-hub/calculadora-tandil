rules_version = '2';

// firestore.rules
//
// OJO: ESTE ARCHIVO NO SE APLICA SOLO. Las reglas que rigen viven en la consola
// de Firebase (Firestore Database -> Reglas). Este archivo es la versión
// versionada y revisable; para que rija hay que pegarlo en la consola y
// publicar, o usar la CLI:
//     firebase deploy --only firestore:rules
//
// LO QUE RIGE HOY EN LA CONSOLA (verificado por prueba el 13/9/2026): lectura
// pública de TODO y escritura para cualquier usuario autenticado de Firebase.
// Alcanza para que el sitio funcione, pero es más laxo de lo que hace falta:
// cualquier colección nueva nace pública, y si el registro estuviera abierto,
// cualquier cuenta podría reescribir las escalas salariales de un sitio
// público. Estas reglas cierran las dos cosas:
//
//   - se lee sin registro sólo lo que la calculadora necesita: los convenios y
//     sus escalas, las tablas de Ganancias, las de contribuciones y las
//     novedades. Todo lo demás está cerrado hasta que se abra a propósito acá;
//   - escribe únicamente el administrador, identificado por el mail con el que
//     entra a /admin.
//
// SI ALGÚN DÍA CAMBIA EL MAIL DEL ADMINISTRADOR, hay que cambiarlo acá y
// publicar ANTES de usar el panel con la cuenta nueva: si no, el panel deja de
// poder guardar. La consola de Firebase sigue accesible igual (las reglas no la
// gobiernan), así que nunca es un encierro definitivo.
//
// Alternativa por UID, si se prefiere: request.auth.uid == "<uid>". El UID
// está en la consola, en Authentication -> Users.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- El único que escribe ------------------------------------------
    // La cuenta de Firebase Authentication (proveedor "password") con la que
    // se entra a /admin. Los tokens de esa cuenta traen el mail.
    function esAdmin() {
      return request.auth != null
          && request.auth.token.email == "admin@csueldos.com";
    }

    // --- Convenios y sus escalas ---------------------------------------
    // Lectura pública: es lo que hace funcionar la calculadora sin registro.
    match /convenios/{convenioId} {
      allow read: if true;
      allow write: if esAdmin();

      match /escalas/{periodo} {
        allow read: if true;
        allow write: if esAdmin();
      }
    }

    // --- Parámetros del impuesto a las Ganancias, por período -----------
    match /parametros_ganancias/{periodo} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Parámetros de contribuciones patronales, por período -----------
    // Lo que el recibo necesita para la sección "Costo total empleador"
    // (art. 140 inc. j) LCT, Decreto 407/2026).
    match /parametros_contribuciones/{periodo} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Novedades del sitio -------------------------------------------
    match /novedades/{novedadId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // --- Todo lo demás está cerrado ------------------------------------
    // Cualquier colección que se agregue en el futuro arranca denegada, y hay
    // que habilitarla a propósito acá (y volver a pegar en la consola).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

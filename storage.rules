rules_version = '2';

// storage.rules
//
// OJO: ESTE ARCHIVO NO SE APLICA SOLO. Las reglas que rigen viven en la consola
// de Firebase (Storage -> Reglas). Este archivo es la versión versionada y
// revisable; para que rija hay que pegarlo en la consola y publicar, o usar la
// CLI:
//     firebase deploy --only storage
//
// Qué guarda Storage: los archivos de los acuerdos paritarios y escalas de cada
// convenio (PDF, imágenes o Word), en acuerdos/<convenio>/<archivo>. Los sube
// el dueño desde /admin y los baja cualquiera desde /acuerdos/<convenio>.
//
//   - se lee sin registro: la descarga es pública a propósito;
//   - escribe únicamente el administrador, identificado por el mismo UID que
//     en firestore.rules, con archivos de hasta 10 MB y de los formatos que el
//     panel acepta (lib/acuerdosPublicados.js);
//   - todo lo demás está cerrado hasta que se abra a propósito acá.
//
// SI ALGÚN DÍA SE CREA OTRO USUARIO ADMINISTRADOR, hay que poner su UID acá Y
// en firestore.rules, y publicar los dos antes de usar el panel con él.

service firebase.storage {
  match /b/{bucket}/o {

    function esAdmin() {
      return request.auth != null
          && request.auth.uid == "yx2H1OsUirUTvevmtTasVnSU5Zw1";
    }

    // El vigía (scripts/vigia.mjs): la cuenta vigia@liquidar.ar. Reemplazar
    // UID_DEL_VIGIA por el UID real, el mismo que en firestore.rules.
    function esVigia() {
      return request.auth != null
          && request.auth.uid == "UID_DEL_VIGIA";
    }

    function formatoPermitido() {
      return request.resource.contentType.matches(
        'application/pdf|image/jpeg|image/png|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
      );
    }

    function pesaHasta10MB() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // --- Archivos de los acuerdos --------------------------------------
    // La descarga es pública. El vigía sólo puede CREAR acá, nunca pisar ni
    // borrar, y sólo un PDF o JPG cuyo nombre siga el patrón del panel
    // (<fecha>-<slug>.<ext>, lib/acuerdosPublicados.js): deja el archivo del
    // acuerdo en su lugar definitivo y el administrador publica el documento
    // desde la Bandeja.
    match /acuerdos/{convenioId}/{archivo} {
      allow read: if true;
      // create y update por separado de delete: al borrar, request.resource es
      // null y una condición sobre su tamaño haría fallar todos los borrados.
      allow create: if (esAdmin() && pesaHasta10MB() && formatoPermitido())
          || (esVigia() && pesaHasta10MB()
              && request.resource.contentType.matches('application/pdf|image/jpeg')
              && archivo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9_]+\\.(pdf|jpg|jpeg)$'));
      allow update: if esAdmin() && pesaHasta10MB() && formatoPermitido();
      allow delete: if esAdmin();
    }

    // --- Archivos de los borradores del vigía --------------------------
    // Los JPG y PDF que el vigía bajó de las fuentes, para que el dueño los
    // mire al lado del borrador. Los leen el administrador y el vigía; el
    // sitio público nunca los muestra.
    match /borradores/{convenioId}/{archivo=**} {
      allow read: if esAdmin() || esVigia();
      allow create, update: if (esAdmin() || esVigia())
          && pesaHasta10MB()
          && formatoPermitido();
      allow delete: if esAdmin() || esVigia();
    }

    // --- Todo lo demás está cerrado ------------------------------------
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
